# Required for the default model (or use its provider-specific standard variable).
LLM_MODEL=mistral/mistral-small-latest
LLM_API_KEY=
# Optional override when the model is not known to LiteLLM; used by the UI context meter.
LLM_CONTEXT_WINDOW_TOKENS=
# Use LiteLLM's bundled cost/context map instead of fetching it at startup.
LITELLM_LOCAL_MODEL_COST_MAP=true

# Optional persistent session database. When omitted, ADK's existing local SQLite
# storage is used. Supported schemes: sqlite, sqlite+aiosqlite,
# postgresql+asyncpg, and mysql+aiomysql.
# SESSION_DATABASE_URL=postgresql+asyncpg://kchat:password@database/kchat
# For SQLite in a container, mount the parent directory as a persistent volume:
# SESSION_DATABASE_URL=sqlite:////data/kchat-sessions.db
SESSION_DATABASE_URL=

# Omit to use the image's /demo RDF. Set an absolute mounted directory or URL.
SPARQL_ENDPOINT=/rdf
# Basic auth for a remote endpoint:
SPARQL_USERNAME=
SPARQL_PASSWORD=
# Or bearer auth (takes precedence over basic auth):
SPARQL_BEARER_TOKEN=

SPARQL_TIMEOUT_SECONDS=30
SPARQL_MAX_RESPONSE_BYTES=10485760
SPARQL_PREVIEW_ITEMS=20

# When set, this replaces the built-in agent instruction.
SYSTEM_PROMPT=

# Optional extra instructions appended after the built-in agent instruction
# (or after SYSTEM_PROMPT when set). Use this to scope the agent to a site.
AGENT_EXTRA_INSTRUCTIONS=

# Optional per-user question rate limiting for /run and /run_sse.
# RATE_LIMIT_QUESTIONS is the maximum per user per window; 0 or unset disables
# the limit. RATE_LIMIT_WINDOW_SECONDS defaults to 3600 (1 hour).
RATE_LIMIT_QUESTIONS=
RATE_LIMIT_WINDOW_SECONDS=3600
